{
  "name": "@pymodel/dsh-tavily",
  "version": "0.4.0",
  "type": "module",
  "description": "Tavily web search for DSH (keyless or keyed, official DeepSeek when off) plus the Tavily MCP: search, extract, crawl, map, research",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PyModel/dsh-research-plugins.git",
    "directory": "packages/dsh-tavily"
  },
  "bugs": {
    "url": "https://github.com/PyModel/dsh-research-plugins/issues"
  },
  "homepage": "https://github.com/PyModel/dsh-research-plugins/tree/main/packages/dsh-tavily#readme",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "license": "MIT",
  "author": {
    "name": "elkaix",
    "url": "https://github.com/elkaix"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "tavily",
    "mcp"
  ],
  "engines": {
    "dsh": ">=0.1.5-rc.2 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-web": ">=0.1.5-rc.2 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2"
  }
}
