{
  "name": "@pymodel/dsh-tavily",
  "version": "0.2.0",
  "type": "module",
  "description": "Tavily web search + Tavily MCP for DSH: settings toggle to official DeepSeek, keyless search, MCP extract/crawl/map",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pymodel/dsh-research-plugins.git",
    "directory": "packages/dsh-tavily"
  },
  "bugs": {
    "url": "https://github.com/pymodel/dsh-research-plugins/issues"
  },
  "homepage": "https://github.com/pymodel/dsh-research-plugins/tree/main/packages/dsh-tavily#readme",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "author": {
    "name": "elkaix",
    "url": "https://github.com/elkaix"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "tavily",
    "mcp"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-web-search-deepseek": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc.6"
  }
}
